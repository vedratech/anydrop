{
  "name": "@vedratech/anydrop-ui",
  "version": "0.0.0",
  "description": "Plain-JavaScript UI for AnyDrop: Dropzone-compatible config, folder tree, mobile friendly.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedratech/anydrop.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/vedratech/anydrop/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/vedratech/anydrop/issues"
  },
  "author": "AnyDrop contributors",
  "keywords": [
    "upload",
    "folder",
    "dropzone",
    "tree",
    "chunked"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm run clean && tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@vedratech/anydrop-core": "workspace:^"
  }
}
