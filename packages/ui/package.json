{
  "name": "@vedratech/anydrop-ui",
  "version": "0.1.0",
  "description": "Folder upload UI for the browser: drag and drop folders, chunked and resumable uploads, pause/resume, progress, retry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedratech/anydrop.git",
    "directory": "packages/ui"
  },
  "homepage": "https://vedratech.github.io/anydrop/",
  "bugs": {
    "url": "https://github.com/vedratech/anydrop/issues"
  },
  "author": "Jayesh Gupta",
  "keywords": [
    "upload",
    "file-upload",
    "folder-upload",
    "directory-upload",
    "drag-and-drop",
    "chunked-upload",
    "resumable-upload",
    "resumable",
    "multipart",
    "large-file-upload",
    "upload-progress",
    "pause-resume",
    "file-uploader",
    "uploader",
    "webkitdirectory",
    "xhr-upload",
    "typescript",
    "vanilla-js",
    "retry",
    "offline",
    "mobile",
    "ios",
    "folder-tree"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./locales/*.global": null,
    "./locales/*": {
      "import": {
        "types": "./dist/locales/*.d.ts",
        "default": "./dist/locales/*.js"
      },
      "require": {
        "types": "./dist/locales/*.d.cts",
        "default": "./dist/locales/*.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm run clean && tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@vedratech/anydrop-core": "workspace:^"
  },
  "typesVersions": {
    "*": {
      "locales/*": [
        "./dist/locales/*.d.ts"
      ]
    }
  }
}
