{
  "name": "@vedratech/anydrop-core",
  "version": "1.0.0",
  "description": "Headless folder upload engine for the browser: chunked and resumable uploads, pause/resume, retry, offline handling. No dependencies, TypeScript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedratech/anydrop.git",
    "directory": "packages/core"
  },
  "homepage": "https://vedratech.github.io/anydrop/",
  "bugs": {
    "url": "https://github.com/vedratech/anydrop/issues"
  },
  "author": "Vedra Tech",
  "keywords": [
    "upload",
    "file-upload",
    "folder-upload",
    "directory-upload",
    "drag-and-drop",
    "chunked-upload",
    "resumable-upload",
    "resumable",
    "multipart",
    "large-file-upload",
    "upload-progress",
    "pause-resume",
    "file-uploader",
    "uploader",
    "webkitdirectory",
    "xhr-upload",
    "typescript",
    "retry",
    "offline",
    "mobile",
    "ios",
    "headless",
    "react-compatible"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm run clean && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
