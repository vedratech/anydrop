{
  "name": "anydrop-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "AnyDrop workspace root. The published packages are @vedratech/anydrop-core and @vedratech/anydrop-ui.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "test:e2e": "playwright test -c e2e",
    "e2e:clean": "node -e \"for (const d of ['e2e/test-results','e2e/playwright-report']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "fixtures": "node e2e/fixtures/generate.mjs",
    "compare": "node e2e/fixtures/compare.mjs",
    "mock-server": "node e2e/mock-server/server.mjs",
    "dev:mock": "node e2e/mock-server/server.mjs",
    "demo": "pnpm --filter @vedratech/anydrop-demo dev",
    "dev:demo": "pnpm --filter @vedratech/anydrop-demo dev",
    "size": "size-limit",
    "check:packages": "node scripts/check-packages.mjs",
    "check:consumer": "node scripts/consumer-smoke.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "docs:protocol": "node scripts/gen-protocol-doc.mjs",
    "docs:dev": "pnpm build && pnpm --filter @vedratech/anydrop-docs dev",
    "docs:build": "pnpm build && pnpm --filter @vedratech/anydrop-docs build",
    "docs:preview": "pnpm --filter @vedratech/anydrop-docs preview"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
